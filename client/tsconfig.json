{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "paths": {
      "@/*": ["./*"]
    },
    "jsx": "react-native", // <-- TAMBAHKAN INI
    "allowSyntheticDefaultImports": true // <-- TAMBAHKAN INI
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
